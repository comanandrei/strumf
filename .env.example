# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth / Auth.js
# Strong secret for production (dev falls back in code if empty):
#   npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Optional. Use the site origin only, e.g. http://localhost:3000
# Do NOT use a path like http://localhost:3000/auth — that breaks /api/auth.
# In development, any path on this URL is auto-stripped to origin when the app loads.
# AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="http://localhost:3000"

# Prisma (PostgreSQL)
# Local: run `docker compose up -d` and use:
#   DATABASE_URL="postgresql://strumf:strumf@localhost:5432/strumf?schema=public"
#   DIRECT_URL="postgresql://strumf:strumf@localhost:5432/strumf?schema=public"
# Then: npx prisma migrate dev
# Neon (example — pooled + direct for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@EP-EXAMPLE-POOLER.us-east-2.aws.neon.tech/DB_NAME?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@EP-EXAMPLE.us-east-2.aws.neon.tech/DB_NAME?sslmode=require&connect_timeout=15"
# Vercel / CI: set DATABASE_URL in the project Environment Variables (required).
# Omit DIRECT_URL to reuse DATABASE_URL — the app mirrors it for Prisma. For Neon pooler +
# migrations, set both pooled DATABASE_URL and non-pooled DIRECT_URL per Neon docs.

# Geoapify (Nearby feature, optional)
# Free tier: 3000 credits/day. Sign up + create a key at https://myprojects.geoapify.com/
# Without this key, Nearby falls back to OpenStreetMap/Overpass with estimated travel times.
# GEOAPIFY_API_KEY=""
